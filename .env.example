SESSION_SECRET=

# E-posta gönderimi (şifre sıfırlama + iletişim formu) — bkz. src/lib/email.ts.
# Önce SMTP_* denenir (Hostinger e-posta kutusu), o yoksa RESEND_API_KEY,
# ikisi de yoksa içerik sadece sunucu loguna yazılır, gerçek e-posta gitmez.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=bilgi@ortatepeler.com
SMTP_PASS=
SMTP_FROM=

RESEND_API_KEY=
RESEND_FROM=
APP_URL=

# İletişim formu (/iletisim) hangi adres(ler)e gitsin. CC virgülle ayrılmış
# birden fazla adres alabilir (ör. ek "bilgi" e-postaları).
CONTACT_FORM_TO=bilgi@ortatepeler.com
CONTACT_FORM_CC=

# Parsel sınırı çizim haritası (Mapbox GL) — boş bırakılırsa harita yerine
# "token eksik" bilgi kartı gösterilir (bkz. src/components/map/MapboxTokenNotice.tsx).
# Tarayıcıda kullanıldığı için NEXT_PUBLIC_ önekiyle tanımlanmalı.
NEXT_PUBLIC_MAPBOX_TOKEN=

# "Ozana Havale Et" ile yeni revize verilince bildirim gidecek adres(ler), virgülle ayrılır.
# Boşsa ozanbalcioglu@gmail.com. E-posta SMTP_* (ya da RESEND_API_KEY) ayarlarıyla gider.
REVIZE_BILDIRIM_EPOSTA=
